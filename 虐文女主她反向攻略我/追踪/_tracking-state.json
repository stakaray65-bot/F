      ],
      "first_recorded_chapter": 9,
      "id": "E014",
      "objective_fact": "配型申请在许知意回国前就由韩淑仪委托、周敬申请；国外转诊件与周敬病历的诊断分期对不上",
      "reader_knowledge": "读者知道配型早有预谋、病历有问题",
      "reveal_chapter": 9,
      "reveal_status": "部分揭示",
      "story_time": "世界1第10天夜",
      "updated_chapter": 9
    },
