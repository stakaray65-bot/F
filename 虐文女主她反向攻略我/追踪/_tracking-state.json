      ],
      "first_recorded_chapter": 10,
      "id": "E015",
      "objective_fact": "陆夫人在老宅茶室提出婚期换撤函，林迟拒婚期、应家宴，定于后天在老宅长桌餐厅，许家父母从外地来",
      "reader_knowledge": "读者全知",
      "reveal_chapter": 10,
      "reveal_status": "已揭示",
      "story_time": "世界1第21天",
